    "adminEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceType",
        "requestId",
        "operation",
        "operatorObjectId",
        "performedAt",
        "adminSurface",
        "targetBindingSha256",
        "audienceBindingSha256",
        "before",
        "after",
        "returnedOperationId",
        "result",
        "immutable",
        "evidenceSha256",
        "previousEvidenceSha256"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/boundedId"
        },
        "evidenceType": {
          "type": "string",
          "enum": [
            "execution",
            "read-back"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/boundedId"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "operatorObjectId": {
          "$ref": "#/$defs/entraObjectId"
        },
        "performedAt": {
          "type": "string",
          "format": "date-time"
        },
        "adminSurface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "targetBindingSha256": {
          "$ref": "#/$defs/sha256"
        },
        "audienceBindingSha256": {
          "$ref": "#/$defs/sha256"
        },
        "before": {
          "type": "object"
        },
        "after": {
          "type": "object"
        },
        "returnedOperationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/boundedId"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "partial"
          ]
        },
        "boundedNotes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "immutable": {
          "const": true
        },
        "evidenceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "previousEvidenceSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "install"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/packageAbsentState"
              },
              "after": {
                "$ref": "#/$defs/packageActiveState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "update"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/packageActiveOrDisabledState"
              },
              "after": {
                "$ref": "#/$defs/packageActiveState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "disable"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/packageActiveState"
              },
              "after": {
                "$ref": "#/$defs/packageDisabledState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "enable"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/packageDisabledState"
              },
              "after": {
                "$ref": "#/$defs/packageActiveState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "remove"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/packageActiveOrDisabledState"
              },
              "after": {
                "$ref": "#/$defs/packageRemovedState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "package-approve"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/packageProposedState"
              },
              "after": {
                "$ref": "#/$defs/packageApprovedState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "registry-add"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/registryAbsentState"
              },
              "after": {
                "$ref": "#/$defs/registryApprovedState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "registry-pause"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/registryApprovedState"
              },
              "after": {
                "$ref": "#/$defs/registryPausedState"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "policy-change"
              }
            }
          },
          "then": {
            "properties": {
              "before": {
                "$ref": "#/$defs/policyCurrentState"
              },
              "after": {
                "$ref": "#/$defs/policyActiveState"
              }
            }
          }
        }
      ]
    },
    "packageOperationState": {
