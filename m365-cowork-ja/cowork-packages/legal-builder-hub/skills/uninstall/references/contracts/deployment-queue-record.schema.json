{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claude-for-legal/legal-builder-hub/deployment-queue-record.schema.json",
  "title": "Legal Builder Hub deployment queue record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "tenantId",
    "practiceId",
    "operation",
    "state",
    "requesterObjectId",
    "reviewerObjectIds",
    "approverObjectIds",
    "deploymentOperatorObjectId",
    "target",
    "audience",
    "rollbackScope",
    "approvalId",
    "targetBindingSha256",
    "audienceBindingSha256",
    "idempotencyKey",
    "itemId",
    "eTag",
    "adminEvidence",
    "immutableEvidenceLog",
    "executionReadBackMatch",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "requestId": {
      "$ref": "#/$defs/boundedId"
    },
    "tenantId": {
      "$ref": "#/$defs/entraObjectId"
    },
    "practiceId": {
      "$ref": "#/$defs/boundedId"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "preflight",
        "awaiting-approval",
        "approved",
        "admin-action-required",
        "executing",
        "succeeded",
        "failed",
        "retry",
        "dead-letter",
        "cancelled",
        "rejected",
        "expired",
        "superseded"
      ]
    },
    "requesterObjectId": {
      "$ref": "#/$defs/entraObjectId"
    },
    "reviewerObjectIds": {
      "$ref": "#/$defs/entraIdArray"
    },
    "approverObjectIds": {
      "$ref": "#/$defs/entraIdArray"
    },
    "deploymentOperatorObjectId": {
      "$ref": "#/$defs/nullableEntraObjectId"
    },
    "actorSeparation": {
      "$ref": "#/$defs/actorSeparation"
    },
    "target": {
      "type": "object"
    },
    "audience": {
      "type": "object"
    },
    "rollbackScope": {
      "type": "object"
    },
    "approvalId": {
      "anyOf": [
        {
          "$ref": "#/$defs/boundedId"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetBindingSha256": {
      "$ref": "#/$defs/sha256"
    },
    "audienceBindingSha256": {
      "$ref": "#/$defs/sha256"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "itemId": {
      "$ref": "#/$defs/boundedId"
    },
    "eTag": {
      "$ref": "#/$defs/boundedId"
    },
    "adminEvidence": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/adminEvidence"
      }
    },
    "immutableEvidenceLog": {
      "const": true
    },
    "executionReadBackMatch": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "install"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/installTarget"
          },
          "audience": {
            "$ref": "#/$defs/packageAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/installRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "update"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/updateTarget"
          },
          "audience": {
            "$ref": "#/$defs/packageAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/packageRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "disable"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/disableTarget"
          },
          "audience": {
            "$ref": "#/$defs/packageAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/packageRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "enable"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/enableTarget"
          },
          "audience": {
            "$ref": "#/$defs/packageAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/packageRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "remove"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/removeTarget"
          },
          "audience": {
            "$ref": "#/$defs/packageAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/packageRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "registry-add"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/registryAddTarget"
          },
          "audience": {
            "$ref": "#/$defs/registryAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/registryAddRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "registry-pause"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/registryPauseTarget"
          },
          "audience": {
            "$ref": "#/$defs/registryAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/registryPauseRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "policy-change"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/policyChangeTarget"
          },
          "audience": {
            "$ref": "#/$defs/policyAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/policyRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "package-approve"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "$ref": "#/$defs/packageApproveTarget"
          },
          "audience": {
            "$ref": "#/$defs/packageAudience"
          },
          "rollbackScope": {
            "$ref": "#/$defs/installRollbackScope"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "approved",
              "admin-action-required",
              "executing",
              "succeeded"
            ]
          }
        }
      },
      "then": {
        "required": [
          "actorSeparation"
        ],
        "properties": {
          "reviewerObjectIds": {
            "$ref": "#/$defs/nonEmptyEntraIdArray"
          },
          "approverObjectIds": {
            "$ref": "#/$defs/nonEmptyEntraIdArray"
          },
          "approvalId": {
            "$ref": "#/$defs/boundedId"
          },
          "actorSeparation": {
            "$ref": "#/$defs/actorSeparation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "executing",
              "succeeded"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "deploymentOperatorObjectId": {
            "$ref": "#/$defs/entraObjectId"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "reviewerObjectIds": {
            "$ref": "#/$defs/nonEmptyEntraIdArray"
          },
          "approverObjectIds": {
            "$ref": "#/$defs/nonEmptyEntraIdArray"
          },
          "deploymentOperatorObjectId": {
            "$ref": "#/$defs/entraObjectId"
          },
          "executionReadBackMatch": {
            "const": true
          },
          "adminEvidence": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/adminEvidence"
            },
            "allOf": [
              {
                "contains": {
                  "$ref": "#/$defs/successfulExecutionEvidence"
                }
              },
              {
                "contains": {
                  "$ref": "#/$defs/successfulReadBackEvidence"
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "boundedId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entraObjectId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "nullableEntraObjectId": {
      "anyOf": [
        {
          "$ref": "#/$defs/entraObjectId"
        },
        {
          "type": "null"
        }
      ]
    },
    "entraIdArray": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entraObjectId"
      }
    },
    "nonEmptyEntraIdArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entraObjectId"
      }
    },
    "boundedIdArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/boundedId"
      }
    },
    "operation": {
      "type": "string",
      "enum": [
        "install",
        "update",
        "disable",
        "enable",
        "remove",
        "registry-add",
        "registry-pause",
        "policy-change",
        "package-approve"
      ]
    },
    "packageAudience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "targetGroupIds",
        "destinationIds"
      ],
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/entraObjectId"
        },
        "targetGroupIds": {
          "$ref": "#/$defs/nonEmptyEntraIdArray"
        },
        "destinationIds": {
          "$ref": "#/$defs/boundedIdArray"
        }
      }
    },
    "registryAudience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "destinationIds"
      ],
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/entraObjectId"
        },
        "targetGroupIds": {
          "$ref": "#/$defs/entraIdArray"
        },
        "destinationIds": {
          "$ref": "#/$defs/boundedIdArray"
        }
      }
    },
    "policyAudience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "targetGroupIds",
        "destinationIds"
      ],
      "properties": {
        "tenantId": {
          "$ref": "#/$defs/entraObjectId"
        },
        "targetGroupIds": {
          "$ref": "#/$defs/nonEmptyEntraIdArray"
        },
        "destinationIds": {
          "$ref": "#/$defs/boundedIdArray"
        }
      }
    },
    "installTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "appId",
        "packageId",
        "skillIds",
        "sourceSnapshotId",
        "sourceSnapshotSha256",
        "targetPackageSha256",
        "targetVersion",
        "targetCatalogId",
        "intendedStatus"
      ],
      "properties": {
        "kind": {
          "const": "package-install"
        },
        "appId": {
          "$ref": "#/$defs/boundedId"
        },
        "packageId": {
          "$ref": "#/$defs/boundedId"
        },
        "skillIds": {
          "$ref": "#/$defs/skillIdArray"
        },
        "sourceSnapshotId": {
          "$ref": "#/$defs/boundedId"
        },
        "sourceSnapshotSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetPackageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetVersion": {
          "$ref": "#/$defs/boundedId"
        },
        "targetCatalogId": {
          "$ref": "#/$defs/boundedId"
        },
        "intendedStatus": {
          "const": "active"
        }
      }
    },
    "updateTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "appId",
        "packageId",
        "skillIds",
        "sourceSnapshotId",
        "sourceSnapshotSha256",
        "currentPackageSha256",
        "targetPackageSha256",
        "diffSha256",
        "currentVersion",
        "targetVersion",
        "updateMode",
        "targetCatalogId",
        "intendedStatus"
      ],
      "properties": {
        "kind": {
          "const": "package-update"
        },
        "appId": {
          "$ref": "#/$defs/boundedId"
        },
        "packageId": {
          "$ref": "#/$defs/boundedId"
        },
        "skillIds": {
          "$ref": "#/$defs/skillIdArray"
        },
        "sourceSnapshotId": {
          "$ref": "#/$defs/boundedId"
        },
        "sourceSnapshotSha256": {
          "$ref": "#/$defs/sha256"
        },
        "currentPackageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetPackageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "diffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "currentVersion": {
          "$ref": "#/$defs/boundedId"
        },
        "targetVersion": {
          "$ref": "#/$defs/boundedId"
        },
        "updateMode": {
          "type": "string",
          "enum": [
            "forward",
            "rollback"
          ]
        },
        "rollbackSourcePackageId": {
          "$ref": "#/$defs/boundedId"
        },
        "rollbackSourcePackageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "rollbackSourceVersion": {
          "$ref": "#/$defs/boundedId"
        },
        "targetCatalogId": {
          "$ref": "#/$defs/boundedId"
        },
        "intendedStatus": {
          "const": "active"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "updateMode": {
                "const": "rollback"
              }
            }
          },
          "then": {
            "required": [
              "rollbackSourcePackageId",
              "rollbackSourcePackageSha256",
              "rollbackSourceVersion"
            ]
          }
        }
      ]
    },
    "disableTarget": {
      "$ref": "#/$defs/packageLifecycleTarget",
      "properties": {
        "kind": {
          "const": "package-disable"
        },
        "intendedStatus": {
          "const": "disabled"
        }
      }
    },
    "enableTarget": {
      "$ref": "#/$defs/packageLifecycleTarget",
      "properties": {
        "kind": {
          "const": "package-enable"
        },
        "intendedStatus": {
          "const": "active"
        }
      }
    },
    "removeTarget": {
      "$ref": "#/$defs/packageLifecycleTarget",
      "properties": {
        "kind": {
          "const": "package-remove"
        },
        "intendedStatus": {
          "const": "removed"
        },
        "removalScope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "assignment",
              "availability",
              "related-flow"
            ]
          }
        }
      },
      "required": [
        "removalScope"
      ]
    },
    "packageLifecycleTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "appId",
        "packageId",
        "skillIds",
        "currentPackageSha256",
        "currentVersion",
        "targetCatalogId",
        "intendedStatus"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "appId": {
          "$ref": "#/$defs/boundedId"
        },
        "packageId": {
          "$ref": "#/$defs/boundedId"
        },
        "skillIds": {
          "$ref": "#/$defs/skillIdArray"
        },
        "currentPackageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "currentVersion": {
          "$ref": "#/$defs/boundedId"
        },
        "targetCatalogId": {
          "$ref": "#/$defs/boundedId"
        },
        "intendedStatus": {
          "type": "string"
        },
        "removalScope": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "registryAddTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "registryId",
        "registryUri",
        "publisherId",
        "currentPolicySha256",
        "targetPolicySha256",
        "policyDiffSha256",
        "intendedStatus"
      ],
      "properties": {
        "kind": {
          "const": "registry-add"
        },
        "registryId": {
          "$ref": "#/$defs/boundedId"
        },
        "registryUri": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2048
        },
        "publisherId": {
          "$ref": "#/$defs/boundedId"
        },
        "currentPolicySha256": {
          "type": "null"
        },
        "targetPolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "policyDiffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "intendedStatus": {
          "const": "approved"
        }
      }
    },
    "registryPauseTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "registryId",
        "registryUri",
        "publisherId",
        "currentPolicySha256",
        "targetPolicySha256",
        "policyDiffSha256",
        "intendedStatus"
      ],
      "properties": {
        "kind": {
          "const": "registry-pause"
        },
        "registryId": {
          "$ref": "#/$defs/boundedId"
        },
        "registryUri": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2048
        },
        "publisherId": {
          "$ref": "#/$defs/boundedId"
        },
        "currentPolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetPolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "policyDiffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "intendedStatus": {
          "const": "paused"
        }
      }
    },
    "policyChangeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "policyId",
        "policyType",
        "currentPolicySha256",
        "targetPolicySha256",
        "policyDiffSha256",
        "intendedStatus"
      ],
      "properties": {
        "kind": {
          "const": "policy-change"
        },
        "policyId": {
          "$ref": "#/$defs/boundedId"
        },
        "policyType": {
          "type": "string",
          "enum": [
            "registry",
            "publisher",
            "license",
            "connector",
            "qa",
            "security",
            "privacy",
            "retention",
            "dlp",
            "deployment"
          ]
        },
        "currentPolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetPolicySha256": {
          "$ref": "#/$defs/sha256"
        },
        "policyDiffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "intendedStatus": {
          "const": "active"
        }
      }
    },
    "packageApproveTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "appId",
        "packageId",
        "skillIds",
        "sourceSnapshotId",
        "sourceSnapshotSha256",
        "targetPackageSha256",
        "targetVersion",
        "targetCatalogId",
        "intendedStatus"
      ],
      "properties": {
        "kind": {
          "const": "package-approve"
        },
        "appId": {
          "$ref": "#/$defs/boundedId"
        },
        "packageId": {
          "$ref": "#/$defs/boundedId"
        },
        "skillIds": {
          "$ref": "#/$defs/skillIdArray"
        },
        "sourceSnapshotId": {
          "$ref": "#/$defs/boundedId"
        },
        "sourceSnapshotSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetPackageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetVersion": {
          "$ref": "#/$defs/boundedId"
        },
        "targetCatalogId": {
          "$ref": "#/$defs/boundedId"
        },
        "intendedStatus": {
          "const": "approved"
        }
      }
    },
    "skillIdArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
      }
    },
    "installRollbackScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeType",
        "priorPackageId",
        "priorPackageSha256",
        "priorVersion",
        "targetGroupIds",
        "destinationIds",
        "restoreMode",
        "ownerObjectId",
        "evidenceId"
      ],
      "properties": {
        "scopeType": {
          "const": "package"
        },
        "priorPackageId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "priorPackageSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "priorVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "targetGroupIds": {
