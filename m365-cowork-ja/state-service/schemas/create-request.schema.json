{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claude-for-legal/create-request.schema.json",
  "title": "Conditional state create request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "practiceId",
    "scopeType",
    "scopeId",
    "recordType",
    "recordId",
    "idempotencyKey",
    "expectedAbsent",
    "payload"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "practiceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scopeType": {
      "type": "string",
      "enum": [
        "tenant",
        "practice",
        "user",
        "matter",
        "session"
      ]
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recordType": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "expectedAbsent": {
      "const": true
    },
    "matterPrecondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "expectedStatus",
        "atomicWithBindingExpectedAbsent"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "eTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "bindingGeneration": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        },
        "expectedStatus": {
          "const": "active"
        },
        "atomicWithBindingExpectedAbsent": {
          "const": true
        }
      },
      "anyOf": [
        {
          "required": [
            "eTag"
          ]
        },
        {
          "required": [
            "version"
          ]
        },
        {
          "required": [
            "bindingGeneration"
          ]
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "session-matter-binding"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "required": [
          "matterPrecondition"
        ],
        "properties": {
          "scopeType": {
            "const": "session"
          },
          "recordId": {
            "const": "active-matter"
          },
          "payload": {
            "allOf": [
              {
                "$ref": "session-binding.schema.json"
              },
              {
                "properties": {
                  "status": {
                    "const": "active"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
