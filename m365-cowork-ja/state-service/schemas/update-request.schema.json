{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claude-for-legal/update-request.schema.json",
  "title": "Conditional state update request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "practiceId",
    "scopeType",
    "scopeId",
    "recordType",
    "recordId",
    "itemId",
    "eTag",
    "idempotencyKey",
    "patch"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "practiceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scopeType": {
      "type": "string",
      "enum": [
        "tenant",
        "practice",
        "user",
        "matter",
        "session"
      ]
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "recordType": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "recordId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "eTag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "patch": {
      "type": "object",
      "minProperties": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "recordType": {
            "const": "session-matter-binding"
          }
        },
        "required": [
          "recordType"
        ]
      },
      "then": {
        "properties": {
          "scopeType": {
            "const": "session"
          },
          "recordId": {
            "const": "active-matter"
          },
          "patch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "revokedAt",
              "revokedBy",
              "revocationReason"
            ],
            "properties": {
              "status": {
                "const": "revoked"
              },
              "revokedAt": {
                "type": "string",
                "format": "date-time"
              },
              "revokedBy": {
                "type": "string",
                "minLength": 1
              },
              "revocationReason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        }
      }
    }
  ]
}
