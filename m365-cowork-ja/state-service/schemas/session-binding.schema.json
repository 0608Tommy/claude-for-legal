{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claude-for-legal/session-binding.schema.json",
  "title": "Session to matter binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "practiceId",
    "userObjectId",
    "sessionId",
    "matterId",
    "status",
    "boundAt",
    "boundBy",
    "expiresAt",
    "revokedAt",
    "revokedBy",
    "revocationReason"
  ],
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "practiceId": {
      "type": "string",
      "minLength": 1
    },
    "userObjectId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "matterId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    },
    "boundAt": {
      "type": "string",
      "format": "date-time"
    },
    "boundBy": {
      "type": "string",
      "minLength": 1
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "revokedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "revokedBy": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "revocationReason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "revokedAt": {
            "type": "null"
          },
          "revokedBy": {
            "type": "null"
          },
          "revocationReason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "revokedAt": {
            "type": "string",
            "format": "date-time"
          },
          "revokedBy": {
            "type": "string",
            "minLength": 1
          },
          "revocationReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  ]
}
