{
  "schemaVersion": 1,
  "sourceInventory": "source-inventory.json",
  "logicalTargetIds": {
    "direct": "ja-jp.cowork.<plugin>.<skill>",
    "powerPlatform": "ja-jp.power.<plugin>.<skill>",
    "admin": "ja-jp.admin.<plugin>.<skill>",
    "internalReference": "ja-jp.ref.<plugin>.<skill>",
    "unsupported": null
  },
  "rules": [
    "The deployed skill name remains the source folder's ASCII kebab-case ID.",
    "Logical target IDs are metadata and must not replace the deployed skill name.",
    "Internal references are flattened into every caller that depends on them.",
    "Power Platform and admin dispositions may keep a Cowork front end, but the state-changing operation runs through an audited flow.",
    "Unsupported items are excluded from deployable packages."
  ],
  "pluginAncillaryArtifacts": {
    ".claude-plugin/plugin.json": "generate Microsoft 365 manifest metadata",
    "README.md": "translate into the package and tenant deployment guide",
    "CLAUDE.md": "translate into a SharePoint-backed practice profile template",
    ".mcp.json": "map through the connector compatibility and auth matrix",
    "agents/*.md": "map through agentMappings into separate Power Platform solutions",
    "hooks/hooks.json": "omit empty source hooks and document that no behavior was lost",
    ".gitignore": "do not copy into the Cowork package"
  },
  "rootArtifacts": [
    {
      "source": "README.md",
      "target": "m365-cowork-ja/docs/README.md",
      "disposition": "translate-and-rewrite-installation"
    },
    {
      "source": "QUICKSTART.md",
      "target": "m365-cowork-ja/docs/QUICKSTART.md",
      "disposition": "translate-and-rewrite-installation"
    },
    {
      "source": "CONNECTORS.md",
      "target": "m365-cowork-ja/docs/CONNECTORS.md",
      "disposition": "translate-and-rewrite-connectors"
    },
    {
      "source": "CONTRIBUTING.md",
      "target": "m365-cowork-ja/docs/CONTRIBUTING.md",
      "disposition": "translate-and-add-target-validation"
    },
    {
      "source": "CODE_OF_CONDUCT.md",
      "target": "m365-cowork-ja/docs/CODE_OF_CONDUCT.md",
      "disposition": "faithful-translation"
    },
    {
      "source": "CLAUDE.md",
      "target": "m365-cowork-ja/docs/SOURCE-MAINTENANCE.md",
      "disposition": "translate-and-rewrite-target-conventions"
    },
    {
      "source": "CLA.md",
      "target": "m365-cowork-ja/docs/CLA.md",
      "disposition": "faithful-translation"
    },
    {
      "source": "LICENSE",
      "target": "each package LICENSE plus docs/LICENSE.ja.md",
      "disposition": "retain-authoritative-original-and-add-reference-translation"
    },
    {
      "source": "references/company-profile-template.md",
      "target": "m365-cowork-ja/shared/company-profile-template.md",
      "disposition": "translate-and-adapt-to-sharepoint"
    },
    {
      "source": "references/dashboard-template.md",
      "target": "m365-cowork-ja/shared/dashboard-template.md",
      "disposition": "translate-and-adapt-to-m365-artifacts"
    },
    {
      "source": "scripts/deploy-managed-agent.sh",
      "target": "m365-cowork-ja/power-platform-solutions deployment tooling",
      "disposition": "replace-not-translate"
    },
    {
      "source": "scripts/lint-tool-scope.py",
      "target": "Power Platform identity and connection scope lint",
      "disposition": "replace-not-translate"
    },
    {
      "source": "scripts/orchestrate.py",
      "target": "Power Platform handoff and schema contract",
      "disposition": "replace-not-translate"
    },
    {
      "source": "scripts/test-cookbooks.sh",
      "target": "Power Platform solution validation tests",
      "disposition": "replace-not-translate"
    },
    {
      "source": "scripts/validate.py",
      "target": "runtime flow payload validation",
      "disposition": "adapt"
    }
  ],
  "cookbookArtifacts": {
    "agent.yaml": "Power Platform parent flow or Copilot Studio orchestration source",
    "subagents/*.yaml": "least-privilege child flows with separate connections",
    "steering-examples.json": "Japanese trigger and payload regression fixtures",
    "README.md": "Japanese security, import, and operations guide"
