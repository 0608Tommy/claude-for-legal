    }
  ],
  "frontmatter": {
    "allowedFields": [
      "name",
      "description",
      "license",
      "metadata",
      "compatibility"
    ],
    "strictCharacterLimit": 20000,
    "nameMinimumCharacters": 1,
    "nameMaximumCharacters": 64,
    "namePattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "descriptionMinimumCharacters": 1,
    "descriptionCharacterLimit": 1024
  },
  "skill": {
    "maximumPerPackage": 20,
    "maximumCompanionFiles": 20,
    "maximumCompanionFileBytes": 5242880,
    "maximumCompanionTotalBytes": 10485760,
    "maximumFileNestingDepth": 3,
    "maximumManifestSkillFolderCharacters": 256,
    "companionDownloadTimeoutSeconds": 15,
    "companionDownloadTimeoutStaticEnforcement": false,
    "recommendedMaximumLines": 500,
    "recommendedMaximumActivatedTokens": 5000,
    "fleetConverterCompatibility": {
      "fileExtensions": [
        ".md",
        ".json",
        ".py",
        ".txt"
      ],
      "scope": "claude-for-legal fleet and /claude-to-cowork-plugin converter compatibility; not a universal Microsoft allowlist"
    }
  },
  "connector": {
    "maximumPerPackage": 10,
    "requiredTransport": "https-streamable-http",
    "localStdioSupported": false
  },
  "package": {
    "maximumToolkitPackageBytes": 10485760
  },
  "jurisdictionResolution": [
    "request",
    "matter",
    "practice-profile",
    "tenant-default"
  ],
  "artifacts": {
    "coworkAppPackage": "separate-zip",
    "powerPlatformSolution": "separate-zip"
  },
  "productionGates": {
    "strictHostValidation": true,
    "officialMicrosoftValidation": true,
    "tenantSmokeTest": true,
    "originalJurisdictionReview": true,
    "japanLawyerReview": true
  }
}
