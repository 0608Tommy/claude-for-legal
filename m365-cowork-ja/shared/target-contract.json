    "checkedAt": "2026-07-19"
  },
  "officialIconSources": [
    {
      "title": "root.icons object",
      "url": "https://learn.microsoft.com/en-us/microsoft-365/extensibility/schema/root-icons?view=m365-app-1.28",
      "gitCommit": "6b6977d3ecac88e4bb94edb4693b7c8d42362aec",
